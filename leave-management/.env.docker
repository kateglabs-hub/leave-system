# Docker Development Environment Configuration
# Copy this file to .env for Docker setup

# Database Configuration - For Docker
DB_HOST=mysql
DB_NAME=leave_management
DB_USER=leave_user
DB_PASSWORD=leave_password

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Session Configuration
SESSION_LIFETIME=7200

# Timezone
APP_TIMEZONE=UTC

# Application Port (exposed on localhost)
APP_PORT=8000

# Database Port (exposed on localhost)
DB_PORT=3306

# PHPMyAdmin Port (exposed on localhost)
PHPMYADMIN_PORT=8080
