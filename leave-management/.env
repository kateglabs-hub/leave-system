# Vercel Neon PostgreSQL Configuration
# For local development with Docker or Neon

# Option 1: Neon DATABASE_URL (recommended for Vercel)
# DATABASE_URL=postgresql://user:password@ep-xxxx-region.neon.tech/dbname?sslmode=require
DATABASE_URL=

# Option 2: Individual environment variables (local Docker development)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=leave_management
DB_USER=leave_user
DB_PASSWORD=leave_password

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Session Configuration
SESSION_LIFETIME=7200

# Timezone
APP_TIMEZONE=UTC

# Application Port
APP_PORT=8000
