# Docker Development Environment Configuration (PostgreSQL)
# Copy this file to .env for Docker setup

# Database Configuration - PostgreSQL
DB_HOST=postgres
DB_PORT=5432
DB_NAME=leave_management
DB_USER=leave_user
DB_PASSWORD=leave_password

# Application Settings
APP_ENV=development
APP_DEBUG=true

# Session Configuration
SESSION_LIFETIME=7200

# Timezone
APP_TIMEZONE=UTC

# Application Port (exposed on localhost)
APP_PORT=8000

# PHPMyAdmin Port (exposed on localhost) - Optional for PostgreSQL
PHPMYADMIN_PORT=8080
