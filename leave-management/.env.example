# Environment Variables Configuration
# Copy this file to .env and update with your actual values

# Database Configuration
# For local development (without Docker): use localhost
# For Docker setup: use "mysql" as DB_HOST
DB_HOST=localhost
DB_NAME=leave_management
DB_USER=root
DB_PASSWORD=your_database_password

# Application Settings
APP_ENV=production
APP_DEBUG=false

# Session Configuration
SESSION_LIFETIME=7200

# Timezone
APP_TIMEZONE=UTC

# Application Port (for Docker)
APP_PORT=8000

# Database Port (for Docker)
DB_PORT=3306

# PHPMyAdmin Port (for Docker)
PHPMYADMIN_PORT=8080

# For Vercel Deployment
# Add these as environment variables in your Vercel project settings:
# - DB_HOST
# - DB_NAME
# - DB_USER
# - DB_PASSWORD
